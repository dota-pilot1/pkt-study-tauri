# Optional overrides for the DB sync tab. Keep this file outside the app repository.
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=5436
LOCAL_DB_NAME=sk_pkt_mes
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_CONTAINER=sk-pkt-mes-postgres
DOCKER_BIN=docker
# 운영 서버 주소를 로컬 설정 파일에 입력하세요.
REMOTE_HOST=
REMOTE_USER=ubuntu
# SSH 개인키 절대경로를 로컬 설정 파일에 입력하세요.
REMOTE_SSH_KEY=
REMOTE_DB_CONTAINER=sk-pkt-mes-postgres
REMOTE_DB_NAME=sk_pkt_mes
REMOTE_DB_USER=postgres
REMOTE_APP_DIR=/home/ubuntu/sk-pkt-mes
